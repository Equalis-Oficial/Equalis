{
  "expo": {
    "name": "Equalis",
    "slug": "equalis",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "primaryColor": "#007ADE",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.edu.uniceplac.equalis"
    },
    "android": {
      "package": "br.edu.uniceplac.equalis",
      "adaptiveIcon": {
        "backgroundColor": "#007ADE"
      },
      "androidStatusBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF",
        "translucent": false
      },
      "androidNavigationBar": {
        "barStyle": "dark-content",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
